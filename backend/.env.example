# Banco de dados local para execução em ambiente de desenvolvimento
DATABASE_URL="file:./dev.db"

# Chave secreta usada para assinar JWTs
JWT_SECRET="troque-por-uma-chave-forte"

# Origens permitidas pelo CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# PORTA opcional do servidor
PORT=5000
