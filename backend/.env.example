NODE_ENV=development
PORT=5000
DATABASE_URL="mysql://USUARIO:SENHA_URL_ENCODED@HOST:3306/BANCO"
JWT_SECRET=
# Origem (protocolo + dominio + porta), sem a subpasta do frontend.
FRONTEND_URL=http://localhost:5173

# Seed opcional, somente em banco de desenvolvimento/homologacao.
# Descomente e preencha para executar npm run seed:test ou npx prisma db seed.
# Cada senha: 20-191 caracteres, maiuscula, minuscula, numero e simbolo.
# LEXFLOW_ALLOW_TEST_USERS=true
# LEXFLOW_TEST_ADMIN_PASSWORD=
# LEXFLOW_TEST_LAWYER1_PASSWORD=
# LEXFLOW_TEST_LAWYER2_PASSWORD=

# Carga real de producao: veja prisma/SEED_PRODUCTION.md.
# Usa diretamente DATABASE_URL deste arquivo.
# LEXFLOW_PROD_ADMIN_PASSWORD=
