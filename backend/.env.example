# Banco de dados MySQL local ou remoto
DATABASE_URL="mysql://root:root@localhost:3306/tcc_lexflow"

# Chave secreta usada para assinar JWTs
JWT_SECRET="troque-por-uma-chave-forte"

# Origens permitidas pelo CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# PORTA opcional do servidor
PORT=5000
